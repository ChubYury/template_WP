section.posts-wrap
  .posts_decor
    img.posts_decor-img(src="@img/bg-figure-right.png")
  .container
    .posts_blocks
      .posts_title Our Journal
      .posts_subtitle Get the latest articles from our journal, writing, discuss and share
      .posts_list
        article.posts_item
          img.posts_item-img(src="@img/posts/post1.jpg")
          .posts_item-content
            p.posts_item-data
              span
                img.posts_item-icon(src="./images/icons/icons.svg#calendar")
                span.posts_item-date April 10, 2022
              span  
                img.posts_item-icon(src="./images/icons/icons.svg#person")  
                span.posts_item-hum Admin
              span  
                img.posts_item-icon(src="./images/icons/icons.svg#comment")
                span.posts_item-comment No Comments
            h3.posts_item-title 6 Tips To Help You Build Your Social Media
                              | Effeciency & Better
            p.posts_item-text Cras ultricies ligula sed magna dictum porta. 
                            | Nulla quis lorem ut libero malesuada feugiat. 
                            | ipsum dolor amet, consectetur adipiscing vestibulum 
                            | ipsum primis in.
            button.posts_item-btn.btn-base read more
